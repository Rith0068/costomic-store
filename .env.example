# Copy to .env and fill in. Never commit .env.

# Password for the single administrator account (min 12 characters).
# Created automatically on first server start.
ADMIN_EMAIL=admin@lumiere.com
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Signs the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Server port (Vite proxies /api here in development).
PORT=3001

# Set to "production" to serve the built dist/ folder from Express.
NODE_ENV=development

# Persistent store. Leave these unset locally and server/store.js falls back to
# server/data/*.json files. On Vercel they are required: create a Redis store
# (Project > Storage > Redis) and Vercel injects both values for you. Without
# them a serverless sandbox falls back to ephemeral /tmp, so admin edits to the
# catalogue and all sessions are lost on the next deploy.
KV_REST_API_URL=
KV_REST_API_TOKEN=
